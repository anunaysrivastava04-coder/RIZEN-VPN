{
  "manifest_version": 3,
  "name": "RIZEN-VPN",
  "version": "1.2.0",
  "description": "Browser proxy with country picker, leak protection and built-in leak tests. Free public servers are untrusted: read the privacy notice.",
  "minimum_chrome_version": "110",
  "permissions": ["proxy", "storage", "privacy", "alarms", "activeTab"],
  "host_permissions": [
    "https://proxylist.geonode.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://raw.githubusercontent.com/*",
    "https://api.proxyscrape.com/*",
    "https://www.cloudflare.com/*",
    "https://one.one.one.one/*",
    "https://1.1.1.1/*",
    "https://1.0.0.1/*",
    "https://www.gstatic.com/*",
    "https://connectivitycheck.gstatic.com/*",
    "https://clients3.google.com/*",
    "https://www.google.com/*",
    "https://cloudflare-dns.com/*",
    "https://dns.google/*",
    "https://dns.quad9.net/*",
    "https://dns.adguard-dns.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "action": {
    "default_title": "RIZEN-VPN",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
